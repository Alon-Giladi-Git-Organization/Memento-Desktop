74,רוברט דה נירו,רדיו,"שואל ""You talkin to me?""","רוברט דה נירו עם מוהוק מצביע באקדח לעבר מקלט רדיו וינטג' ישן שמשמיע את מהדורת החדשות ושואל ""You talkin' to me?""? הרדיו משמיע שוב צלילים, ורוברט שואל שוב ""You talkin' to me??"". הרדיו פותח פה מתכתי וצורח עליו, נשמע רעש סטטי צורם ופיצוץ רמקולים, ריח אבק וקבלים שרופים באף והמתכת המחוספסת רוטטת בעוצמה",74,74,1792349190446,TRUE
75,רון חולדאי,רוח,חותם בחתומת על דף,"רון חולדאי עם ארשת רצינית של ראש עיר יושב ו-חותם בחתומת גומי כבדה על דף היתרי בנייה (""דוּף!""), בדיוק כש-רוח הוריקן אלימה שואבת את הקירות והחלונות של המשרד. הרוח מקפיאה את פניו הקשות, הדפים חותכים את ידיו (Paper cut) ושורקים בסערה שחונקת לו את הנשימה בריח רחוב רטוב.",75,75,1792349190446,TRUE
76,רוב שניידר,ראש,מנקה אקווריום בתחתונים,"רוב שניידר בתחתונים מקרצף אקווריום בהיסטריה, כשראש של פסל רומאי ענק נופל לתוך המים ומצמיד אותו לתחתית, ומעיף את כל המים והדגים החוצה ; קול ניפוץ זכוכית רטוב, סירחון עז של אצות ודגים חיים, והמים קפואים",76,76,1792349190446,TRUE
77,רונאלד רייגן,ריר,לועס באפאתיות,"רונאלד רייגן בכובע קאובוי נואם לאומה האמריקאנית ולועס סוכריות גומי בתנועות מגושמות, ועם כל נגיסה ריר מגעיל ודביק נפלט ונשפך מכל סוכריה ומרטיב לו את הסנטר והחולצה 1 עובדי במה מסכנים צריכים להיכנס לפריים כל כמה שניות ולנגב אותו כמו תינוק ; נשמע קול ""שלוק"" רטוב ומגעיל, ריח חמוץ וטחוב באף והנוזל החמים והחלקלק נוטף על החליפה",77,77,1792349190446,TRUE
78,רבקה מיכאלי,רעם,"צווחת ""פתוח""","רבקה מיכאלי צווחת ""פתוח!"" בחיוך, ובאותו רגע פוגע בה חזיז רעם מחשמל שמעמיד לה את כל השיער ומשחיר לה את הפנים; פיצוץ על-קולי שמרעיד את החזה, ריח גופרית בוערת וצריבת חשמל חמה על העור",78,78,1792349190446,TRUE
79,רוזה פארקס,עורף,נוהגת באוטובוס,"רוזה פארקס יושבת במבט נחוש ואמיץ ו-נוהגת באוטובוס נוסעים רעוע בשיא המהירות, ההגה עשוי מעורף שעיר של גבר גזען שצועק, ורוזה מסובבת בחוזקה ושומעת ""קנאק!"" מזעזע של שבירת מפרקת עורפית, והגומי היבש מחכך את ידיה בזיעה פושרת של מתח ומחנק מוסרי.",79,79,1792393421531,TRUE
80,מרטין סקורסזה,מוס,גוזר סרט פילם,"מרטין סקורסזה גוזר בזהירות סרט פילם ארוך, מכווץ את גבותיו העבות וצועק ""קאט!"" בזמן שגנגסטרים יורים עליו קעריות קטנות של מוס שוקולד מוקצף שמכסה את המשקפיים והפה שלו; נשמע יריות תת-מקלע וצליל ספריי קצפת (""פששש!""), טעם שוקולד מריר מתוק בפה והמרקם אוורירי, קר ודביק",80,80,1792349190446,TRUE
81,מרטין לותר קינג,מול (קניון),"צועק ""יש לי חלום!""","מרטין לותר קינג זועק בקול רועם ""I Have a Dream!"" כאשר מאחוריו נדלקות אותיות זוהרות גדולות שמצהירות על פתיחתו של ""קינג קניון!"", מרכז קניות אמריקאי ענק לשחורים בלבד ; דלתות זכוכית אוטומטיות נפתחות , אוויר מזגנים קפוא שוטף את הקהל, נשמע הדהוד מיקרופון וצלצול קופות, ריח פופקורן ובושם זול של קניונים והניילונים חונקים ומחליקים",81,81,1792349190446,TRUE
82,מיסטר בין,אמבה/עמבה,החייאה,"מיסטר בין, עם פרצופו המעוות והלחוץ, מנסה לבצע החייאה נואשת ועיסויי חזה על אמבה גדוה ומסכנה ששוכבת ברחוב. בכל לחיצה קדחתנית שלו, נשמע קול ""סקוויש"" רטוב ומגעיל, האמבה מעוותת את פניה בכאב וצועקת, וגייזר של רוטב עמבה כתום זרחני משפריץ ממנה ישר לתוך הפה הפעור של מיסטר בין בזמן שהוא מנסה לעשות הנשמה מפה לפה. סירחון חריף ומחניק של חילבה ומנגו כבוש צורב לו את העיניים עד דמעות, והרוטב השמנוני, החמוץ והמלוח מדביק לו את חליפת הטוויד לרצפה.",82,82,1792349190446,TRUE
83,מייקל ג'ורדן,מאג,חובט במחבט גולף,"מייקל ג'ורדן בבגדי הגולף הרפויים שלו עושה תנופה מושלמת ו-חובט במחבט גולף מברזל,  אבל הוא מנפץ במקום כדור מאג קפה (כוס חרס) עבה מקרמיקה שחורה כבדה. המאג מתפצפץ לרסיסים מחודדים בצליל ניפוץ דוקר, והקפה הרותח שעמד בתוכו מתיז על נעלי הספורט היקרות שלו ומעלה אדי צריבה מתוקים וכהים.",83,83,1792349190446,TRUE
84,מאט דיימון,מד (מדחום),מגדל תפוחי אדמה במאדים,"מאט דיימון בחליפת חלל כתומה תוקע מד חום זכוכית ענק באדמת מאדים כדי למדוד את החום של החרא איתו הוא מגדל את תפוחי האדמה שלו ; המדחום שורק מחום והכספית הכסופה רותחת; נשמע ניפוץ זכוכית ואזעקת חמצן מצפצפת, ריח מתכת חמה ואבק אדום והכספית הכבדה מתגלגלת על הפנים",84,84,1792349190446,TRUE
85,מיה חליפה,מוח,מזדיינת,"מיה חליפה על המיטה עם משקפיים וחיג'אב, מתמזמזת עמוקות עם מוח אנושי ענק ופועם ומחשמל שמטפטף ג'לטין ורוד שנוזל ומרטיב את החזה שלה; קול פעימות דופק ""דופ-דופ"" רטוב, ריח רפואי חריף והמרקם קמטי ורוטט",85,85,1792349190446,TRUE
86,מאיר שלו,משי,מקריא סיפור ליעלים במדבר,"מאיר שלו מקריא בספר במדבר ליעלים מסוקרנים שרועים בנחת בשדה של פרחים ורודים שעשויים ממשי דק ואיכותי ; רשרוש בד נעים ברוח יחד עם פעיות יעלים, ריח של חול צחיח והמשי קריר וחלק כמים",86,86,1792349190446,TRUE
87,מארק רופאלו,מרה,מכה באגרופים על הרצפה,"מארק רופאלו מנסה לכסוס ציפורניים, אך הן מרוחות בלקת מרה ירוקה ועבה שמגעילה אותו ועושה לו טעם מר בפה ; מתוסכל, הוא מתנפח בזעם, קורע את חולצתו והופך לענק הירוק (האלק) ; נשמע שאגת מפלצת וקול פקיעה רטוב, טעם מר להחריד שגורם לעווית בפה והנוזל הירוק שורף ודביק",87,87,1792349190446,TRUE
88,מרילין מונרו,מים,עומדת בשמלה מעל פתח אוורור,"מרילין מונרו צוחקת ומחזיקה את שמלתה הלבנה כשמפתח האוורור במדרכה פורץ גייזר מים קפואים ונוצצים שבמקום להרים את שמלתה בעדינות מעיף אותה לתקרה ומקפיא לה את התחת; נשמע שאון סילון מים וצחקוק מתגלגל, טעם מים קרים עם בועות סודה בפה והבד הרטוב נצמד לגוף הקפוא",88,88,1792349190446,TRUE
89,מייקל פלפס,מפה,שוחה פרפר,"מייקל פלפס חותר בשחיית פרפר עוצמתית בתוך בריכה שמלאה עד סיפה במפות קלף עתיקות מנייר קלף מרשרש שחותכות לו את הידיים והרגליים, בקושי מאפשרות לו להתקדם, ומורחות כתמי דיו על כל גופו ; נשמע חבטות ידיים וקריעת נייר יבש, ריח כלור חריף ונייר ישן באף והקלף המחוספס שורט את הכתפיים",89,89,1792349190446,TRUE
90,פטריק סטיוארט,פס,נוסע בכיסא גלגלים,"פטריק סטיוארט, קירח בתחפושת של פרופסור אקס, שם את ידו על המצח ומנסה להרים את עצמו מעל מעבר חציה טרי בכביש, שהפסים שלו בדיוק נצבעו ויכולים ללכלף את גלגלי הכיסא שלו ; ריח צבע כבישים טרי וזפת רותחת והפס דביק ומחוספס",90,90,1792349190446,TRUE
91,פרופסור לופין,פיל,הופך לאדם זאב,"פרופסור לופין קורע את בגדיו מו להירח המלא תוך הפיכה לזאב, אך במקום להתחיל לצוד הוא נמחץ פתאום על ידי פיל ורוד עצום שמתיישב עליו ותוקע בחדק (סנייפ הרים אותו עליו באמצעות וינגארדיום לביוסה); שאגת זאב קטועה בנפיחת פיל אדירה, ריח צואת פילים חם, ועור הפיל עבה וקמחי",91,91,1792349190446,TRUE
92,פירס ברוסנן,פאב,יורה באקדח עם משתיק קול,"פירס ברוסנן מסדר עניבת פרפר, מפיל בבעיטה דלת של פאב אירי (תלתן ירוק גדול על הדלת, מוסיקה אירית שמחה מבפנים) ויורה באקדח עם משתיק קול בדיוק במצח של הברמן - לפרקון מרושע שמסיים לנגב כוס. הלפרקון מתפוצץ למטר של מטבעות וחביות בירה מקציפות; נשמע ""פיו!"" חרישי, ניפוץ כוסות בירה ושירה שיכורה, טעם בירה מרירה וקצף קר בפה והרצפה דביקה מאלכוהול ומצלצלת ממטבעות",92,92,1792349190446,TRUE
93,פורסט גאמפ,פוג,רץ ,"פורסט גאמפ רץ לאורך כביש ארוך כשקופסת שוקולד בידו ; הוא עוצר לאכול, פותח את הקופסה אך במקום שוקולדים יש שם רק מטבעות פוגים קשיחי מקרטון. הוא בוחר אחד צהוב עם ציור של סמיילי (Have a nice Day!), מכרסם את הקרטון המר וממשיך לרוץ",93,93,1792349190446,TRUE
94,פיטר דנקלינג',פד (תחבושת),יורה בחץ וקשת,"פיטר דינקלג' יורה חץ קשת בוער לעבר אביו שיושב על האסלה ; החץ פוגע בין רגליו של טייווין ישר בתוך פד היגייני שלבש הזקן, אשר מתלקח מיד ושורף את מפשעתו ; קול תסיסה של דם ואש, סירחון של צמר גפן נשרף, והפד ספוגי, רך ולוהט",94,94,1792349190446,TRUE
95,פרידה קאלו,פיח,שורפת לעצמה את הגבות,"פרידה קאלו עם זר פרחים צבעוני בשיער שורפת לעצמה את הגבה האימנתית שלהף ועם הפיח מהשריפה מציירת לעצמה 2 גבות חדשות ונפרדות; נשמע שיעול עשן ושריקת מכחול, ריח פחם שרוף וצבע שמן חריף באף והפיח השמנוני והאבקתי נמרח על הפנים",95,95,1792349190446,TRUE
96,פיונה שרק,פשע,בועטת באוויר (סגנון מטריקס),"פיונה העוגית הירוקה קופצת בבעיטת מטריקס בהילוך איטי, לוקחת רגע להוציא ליפסטיק מהפאוץ' שלה ולתקן את האיפור - ואז ממשיכה בהילוך מהיר ובועטת באויביה",96,96,1792349190446,TRUE
97,פול ראד,פיר (מעלית),קופץ ראש,"פול ראד בתחפושת אנטמן רודף אחרי קאנג שמנסה לברוח מממלכת הקוואנטום באמצעות תעלה מולטיוורסלית שבנה בתוך פיר מעלית ארוך וחשוך (הוא רק צריך ליפול מספיק מהר כדי להשיג תנופה!) ; קאנג קופץ לתוך הפיר, ואנטמן מתכווץ וכ=קופץ ישר אחריו",97,97,1792349190446,TRUE
98,פול מקרטני,פים (מבחנת חלקיקי פים),מנגן בגיטרה,"פול מקרטני מנגן בגיטרה בהופעה של הביטלס, ואז מקליק בשקט על לחצן קטן שמפעיל מבחנת חלקיקי פים אדומה וזוהרת שמכווצת אותו ואת הגיטרה לגודל נמלה, ואז מיד מגדילה אותו לגודל גורד שחקים; נשמע אקורד בס שמשנה תדר מצפצוף דק לרעם עמוק, טעם תות כימי בפה והזכוכית הקרה רוטטת, ואלפי בנות היסטריות מריעות",98,98,1792349190446,TRUE
99,פבלו פיקאסו,פוף,מצייר במכחול,"פבלו פיקאסו בחולצת פסים מצייר במכחול ענק על פוף עור צבעוני שמתחיל להתעוות לקוביות ומשולשים קוביסטיים ואז מתפוצץ למיליון כדוריות קלקר; נשמע חריקת עור ורשרוש חשמל סטטי של קלקר, ריח טרפנטין חריף באף וכדוריות הקלקר הקטנות נדבקות לכל הגוף",99,99,1792349190446,TRUE