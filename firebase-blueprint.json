{
  "entities": {
    "User": {
      "title": "User Profile & Gamification",
      "description": "User profile with points, badges, daily streaks and level",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "points": { "type": "number", "description": "XP / Total score" },
        "level": { "type": "number" },
        "levelTitle": { "type": "string" },
        "badges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dailyStreak": { "type": "number" },
        "lastChallengeDate": { "type": "string" },
        "exercisesCompleted": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "points", "level"]
    },
    "MemoryPalace": {
      "title": "Memory Palace",
      "description": "Custom or default memory palace with loci stations and associations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "isPermanent": { "type": "boolean" },
        "loci": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "stepNumber": { "type": "number" },
              "roomName": { "type": "string" },
              "title": { "type": "string" },
              "positionDescription": { "type": "string" },
              "storedContent": { "type": "string" },
              "mnemonicScene": { "type": "string" },
              "is_ready_for_practice": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "name"]
    },
    "PersonalAssociation": {
      "title": "Personal Association",
      "description": "User custom association for phone numbers, facts, codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetSubject": { "type": "string" },
        "storedNumberOrFact": { "type": "string" },
        "encodedMnemonic": { "type": "string" },
        "methodUsed": { "type": "string" },
        "is_ready_for_practice": { "type": "boolean" },
        "successCount": { "type": "number" },
        "failCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "targetSubject", "encodedMnemonic"]
    },
    "TestResult": {
      "title": "Test Result",
      "description": "Record of a recall test evaluated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "question": { "type": "string" },
        "targetAssociation": { "type": "string" },
        "userResponse": { "type": "string" },
        "isCorrect": { "type": "boolean" },
        "score": { "type": "number" },
        "verdictTitle": { "type": "string" },
        "explanation": { "type": "string" },
        "memoryTip": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "score", "isCorrect"]
    },
    "MajorItem": {
      "title": "Major Item 00-99",
      "description": "Hebrew phonetic major system word and mental picture for a number",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "number" },
        "numberStr": { "type": "string" },
        "consonants": { "type": "string" },
        "defaultWord": { "type": "string" },
        "userWord": { "type": "string" },
        "imageHint": { "type": "string" },
        "userImageHint": { "type": "string" },
        "is_ready_for_practice": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["number", "numberStr", "consonants", "defaultWord"]
    },
    "PAOItem": {
      "title": "PAO Item",
      "description": "Person Action Object triple for 00-99",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "number" },
        "numberStr": { "type": "string" },
        "person": { "type": "string" },
        "action": { "type": "string" },
        "object": { "type": "string" },
        "userPerson": { "type": "string" },
        "userAction": { "type": "string" },
        "userObject": { "type": "string" },
        "is_ready_for_practice": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["number", "numberStr", "person", "action", "object"]
    },
    "BodyPegItem": {
      "title": "Body Peg Item",
      "description": "Anatomical anchor peg 1-20",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "index": { "type": "number" },
        "bodyPartHebrew": { "type": "string" },
        "userBodyPart": { "type": "string" },
        "defaultObject": { "type": "string" },
        "userObject": { "type": "string" },
        "kineticTip": { "type": "string" },
        "is_ready_for_practice": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["index", "bodyPartHebrew", "defaultObject"]
    },
    "ShapePegItem": {
      "title": "Shape Peg Item",
      "description": "Number shape visual peg 0-9",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "number" },
        "shapeName": { "type": "string" },
        "userShapeName": { "type": "string" },
        "visualMetaphor": { "type": "string" },
        "defaultObject": { "type": "string" },
        "is_ready_for_practice": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["number", "shapeName", "defaultObject"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with points, badges and streak"
    },
    "/major_items/{itemId}": {
      "schema": "MajorItem",
      "description": "Hebrew major system numbers 00 to 99"
    },
    "/pao_items/{itemId}": {
      "schema": "PAOItem",
      "description": "PAO triples 00 to 99"
    },
    "/body_pegs/{pegId}": {
      "schema": "BodyPegItem",
      "description": "Body peg anchors"
    },
    "/shape_pegs/{pegId}": {
      "schema": "ShapePegItem",
      "description": "Shape peg numbers"
    },
    "/palaces/{palaceId}": {
      "schema": "MemoryPalace",
      "description": "User memory palaces"
    },
    "/personal_associations/{assocId}": {
      "schema": "PersonalAssociation",
      "description": "Custom user mnemonics and associations"
    },
    "/test_results/{testId}": {
      "schema": "TestResult",
      "description": "History of active recall tests"
    }
  }
}
