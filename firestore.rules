rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rowy Dashboard & Admin collections
    match /_rowy_/{document=**} {
      allow read, write: if true;
    }

    // User profile & gamification
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || resource == null);
    }

    // Multi-tenant tabular collections for Rowy (pao_items, major_items, palaces, etc.):
    // - Read: allowed for authenticated users and defaults
    // - Create/Update: user must be the document owner (userId == request.auth.uid)
    // - Delete: user must be the document owner (userId == request.auth.uid)
    match /{collectionName}/{docId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == 'system_default'
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
      );
    }
  }
}

