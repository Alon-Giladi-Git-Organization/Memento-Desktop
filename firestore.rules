rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rowy Dashboard & Admin collections
    match /_rowy_/{document=**} {
      allow read, write: if true;
    }

    // User profile & gamification
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || resource == null);
    }

    // Tabular Collections: Major System 00-99
    match /major_items/{itemId} {
      allow read, write: if true;
    }

    // PAO 00-99
    match /pao_items/{itemId} {
      allow read, write: if true;
    }

    // Peg systems: Body pegs
    match /body_pegs/{pegId} {
      allow read, write: if true;
    }

    // Peg systems: Number shape pegs
    match /shape_pegs/{pegId} {
      allow read, write: if true;
    }

    // Memory Palaces
    match /palaces/{palaceId} {
      allow read, write: if true;
    }

    // Personal contact associations
    match /personal_associations/{assocId} {
      allow read, write: if true;
    }

    // People face cards
    match /people_cards/{cardId} {
      allow read, write: if true;
    }

    // Abstract shapes
    match /abstract_shapes/{shapeId} {
      allow read, write: if true;
    }

    // Academic key points
    match /academic_points/{pointId} {
      allow read, write: if true;
    }

    // Tests & results
    match /test_results/{testId} {
      allow read, write: if true;
    }

    // AI Feedbacks
    match /ai_feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Major digits (0-9 definition)
    match /major_digits/{digitId} {
      allow read, write: if true;
    }

    // User custom data
    match /user_custom_data/{customId} {
      allow read, write: if true;
    }

    // Global fallback for any additional tabular collections
    match /{collectionName}/{docId} {
      allow read, write: if true;
    }
  }
}
